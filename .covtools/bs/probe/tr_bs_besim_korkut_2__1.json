{"schemaVersion":1,"category":"quran","edition":{"id":"tr_bs_besim_korkut_2","language":"bs","languageName":"bosnian","author":"Besim Korkut","authorSource":"source-metadata","displayName":"Besim Korkut","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"qcom_126","sourcePath":"Quran/ayah by ayah/bs_bosnian/tr_bs_besim_korkut_2.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"U ime Allaha, Milostivog, Samilosnog!"},{"numberInSurah":2,"text":"Tebe, Allaha, Gospodara svjetova, hvalimo,"},{"numberInSurah":3,"text":"Milostivog, Samilosnog,"},{"numberInSurah":4,"text":"Vladara Dana sudnjeg,"},{"numberInSurah":5,"text":"Tebi se klanjamo i od Tebe pomoć tražimo!"},{"numberInSurah":6,"text":"Uputi nas na Pravi put,"},{"numberInSurah":7,"text":"na Put onih kojima si milost Svoju darovao, a ne onih koji su protiv sebe srdžbu izazvali, niti onih koji su zalutali!"}]},"sourceApi":"Islamic - Your Daily Companion"}