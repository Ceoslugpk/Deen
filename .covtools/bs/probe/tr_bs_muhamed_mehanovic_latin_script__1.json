{"schemaVersion":1,"category":"quran","edition":{"id":"tr_bs_muhamed_mehanovic_latin_script","language":"bs","languageName":"bosnian","author":"Muhamed Mehanovic (Latin Script)","authorSource":"source-metadata","displayName":"Muhamed Mehanovic (Latin Script)","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"bos-muhamedmehanovi-la","sourcePath":"Quran/ayah by ayah/bs_bosnian/tr_bs_muhamed_mehanovic_latin_script.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"S imenom Allaha, Svemilosnog, Milostivog"},{"numberInSurah":2,"text":"Svaka hvala neka je Allahu, Gospodaru svjetova"},{"numberInSurah":3,"text":"Svemilosnom, Milostivom"},{"numberInSurah":4,"text":"Vladaru Dana sudnjeg"},{"numberInSurah":5,"text":"Samo Tebi ibadet cinimo i samo od Tebe pomoc molimo"},{"numberInSurah":6,"text":"Uputi nas na Pravi put"},{"numberInSurah":7,"text":"Na put onih kojima si blagodati podario. A ne na put onih na koje se srdzba izlila, niti na put onih koji su zalutali"}]},"sourceApi":"Islamic - Your Daily Companion"}