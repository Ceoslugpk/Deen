{"schemaVersion":1,"category":"quran","edition":{"id":"tr_bs_mustafa_mlivo","language":"bs","languageName":"bosnian","author":"Mustafa Mlivo","authorSource":"source-metadata","displayName":"Mlivo","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"bs.mlivo","sourcePath":"Quran/ayah by ayah/bs_bosnian/tr_bs_mustafa_mlivo.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"U ime Allaha, Milostivog, Milosrdnog!"},{"numberInSurah":2,"text":"Hvala Allahu, Gospodaru svjetova,"},{"numberInSurah":3,"text":"Milostivom, Milosrdnom,"},{"numberInSurah":4,"text":"Vladaru Dana sudnjeg!"},{"numberInSurah":5,"text":"Tebe obožavamo i od Tebe pomoć tražimo."},{"numberInSurah":6,"text":"Uputi nas na put pravi"},{"numberInSurah":7,"text":"Put onih kojima si blagodat darovao, Ne onih na kojima je srdžba, niti zalutalih."}]},"sourceApi":"Islamic - Your Daily Companion"}