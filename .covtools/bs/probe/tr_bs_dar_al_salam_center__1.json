{"schemaVersion":1,"category":"quran","edition":{"id":"tr_bs_dar_al_salam_center","language":"bs","languageName":"bosnian","author":"Dar Al-Salam Center","authorSource":"source-metadata","displayName":"Dar Al-Salam Center","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"qcom_214","sourcePath":"Quran/ayah by ayah/bs_bosnian/tr_bs_dar_al_salam_center.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"U ime Allaha, Milostivog, Samilosnog!"},{"numberInSurah":2,"text":"Sva hvala pripada Allahu, Gospodaru svih svjetova!"},{"numberInSurah":3,"text":"Milostivom, Samilosnom!"},{"numberInSurah":4,"text":"Vladaru Sudnjega dana!"},{"numberInSurah":5,"text":"Samo Tebe obožavamo i samo od Tebe pomoć tražimo!"},{"numberInSurah":6,"text":"Uputi nas na Pravi put!"},{"numberInSurah":7,"text":"Na put onih kojima si blagodati Svoje darovao, a ne na put onih na koje si se rasrdio, niti onih koji su zalutali."}]},"sourceApi":"Islamic - Your Daily Companion"}