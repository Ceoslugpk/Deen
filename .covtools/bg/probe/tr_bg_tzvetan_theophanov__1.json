{"schemaVersion":1,"category":"quran","edition":{"id":"tr_bg_tzvetan_theophanov","language":"bg","languageName":"bulgarian","author":"Tzvetan Theophanov","authorSource":"source-metadata","displayName":"Теофанов","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"bg.theophanov","sourcePath":"Quran/ayah by ayah/bg_bulgarian/tr_bg_tzvetan_theophanov.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"В името на Аллах, Всемилостивия, Милосърдния!"},{"numberInSurah":2,"text":"Хвала на Аллах - Господа на световете,"},{"numberInSurah":3,"text":"Всемилостивия, Милосърдния,"},{"numberInSurah":4,"text":"Владетеля на Съдния ден!"},{"numberInSurah":5,"text":"Само на Теб служим и Теб за подкрепа зовем."},{"numberInSurah":6,"text":"Насочи ни по правия път,"},{"numberInSurah":7,"text":"пътя на тези, които си дарил с благодат, а не на [тези], над които тегне гняв, нито на заблудените!"}]},"sourceApi":"Islamic - Your Daily Companion"}