{"schemaVersion":1,"category":"quran","edition":{"id":"tr_az_vasim_mammadaliyev_and_ziya_buny","language":"az","languageName":"azerbaijani","author":"Vasim Mammadaliyev and Ziya Bunyadov","authorSource":"source-metadata","displayName":"Məmmədəliyev & Bünyadov","variant":"translation","ayahCount":6236,"sourceApi":"Islamic - Your Daily Companion","provenance":{"sourceIdentifier":"az.mammadaliyev","sourcePath":"Quran/ayah by ayah/az_azerbaijani/tr_az_vasim_mammadaliyev_and_ziya_buny.json"}},"surah":{"number":1,"ayahs":[{"numberInSurah":1,"text":"Mərhəmətli, rəhmli Allahın adı ilə!"},{"numberInSurah":2,"text":"Həmd (şükür və tə’rif) olsun Allaha (və ya: Həmd məxsusdur Allaha) – aləmlərin Rəbbinə,"},{"numberInSurah":3,"text":"(Bu dünyada hamıya) mərhəmətli, (axirətdə isə ancaq mö’minlərə) rəhmli olana,"},{"numberInSurah":4,"text":"Haqq-Hesab (qiyamət) gününün sahibinə!"},{"numberInSurah":5,"text":"Biz yalnız Sənə ibadət edirik və yalnız Səndən kömək diləyirik!"},{"numberInSurah":6,"text":"Bizi doğru (düz) yola yönəlt!"},{"numberInSurah":7,"text":"Ne’mət verdiyin kəslərin yoluna! Qəzəbə düçar olmuşların və (haqdan) azmışların (yoluna) yox!"}]},"sourceApi":"Islamic - Your Daily Companion"}