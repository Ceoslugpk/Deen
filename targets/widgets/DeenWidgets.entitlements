<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Group is the whole reason the widget can show anything.

  A widget extension runs in its own sandbox. Without a shared group it has no
  way to see the prayer times the app worked out, and it will render its empty
  state forever without ever failing.

  This identifier must match three places: here, the app's own entitlements
  (added by plugins/widgets/withWidgets.js), and `suiteName` in the Swift.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.qashi.islamic</string>
	</array>
</dict>
</plist>
