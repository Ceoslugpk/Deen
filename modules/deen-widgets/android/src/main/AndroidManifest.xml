<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Already used by Adhan; no GPS, exact-alarm or foreground-service
         permissions are added for widgets. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:supportsRtl="true">
        <receiver android:name="com.deen.widgets.PrayerWidgetReceiver" android:exported="false" android:label="@string/widget_prayer">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/prayer_widget_info" />
        </receiver>
        <receiver android:name="com.deen.widgets.AyahWidgetReceiver" android:exported="false" android:label="@string/widget_ayah">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ayah_widget_info" />
        </receiver>
        <receiver android:name="com.deen.widgets.TasbihWidgetReceiver" android:exported="false" android:label="@string/widget_tasbih">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/tasbih_widget_info" />
        </receiver>
        <receiver android:name="com.deen.widgets.HijriWidgetReceiver" android:exported="false" android:label="@string/widget_hijri">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hijri_widget_info" />
        </receiver>
        <receiver android:name="com.deen.widgets.WidgetTimeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
