{
  "expo": {
    "name": "Islamic",
    "slug": "islamic-companion",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2D187D",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png",
      "dark": {
        "backgroundColor": "#2D187D",
        "resizeMode": "contain",
        "image": "./assets/splash-icon.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qashi.islamic",
      "icon": {
        "light": "./assets/ios-icon-light.png",
        "dark": "./assets/ios-icon-dark.png"
      }
    },
    "android": {
      "package": "com.qashi.islamic",
      "adaptiveIcon": {
        "backgroundColor": "#2D187D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "splash": {
        "backgroundColor": "#2D187D",
        "resizeMode": "contain",
        "image": "./assets/splash-icon.png",
        "dark": {
          "backgroundColor": "#2D187D",
          "resizeMode": "contain",
          "image": "./assets/splash-icon.png"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D187D",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#2D187D",
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
      "expo-audio",
      {
        "enableBackgroundPlayback": true
      }
    ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_mishary.m4a",
            "./assets/sounds/adhan_mansour.m4a",
            "./assets/sounds/adhan_ozcan.m4a",
            "./assets/sounds/adhan_nafees.m4a",
            "./assets/sounds/adhan_abdulbasit.m4a",
            "./assets/sounds/adhan_minshawi.m4a",
            "./assets/sounds/fajr_mansour.m4a",
            "./assets/sounds/fajr_traditional.m4a"
          ]
        }
      ],
      "./plugins/withBatteryExemption.js",
      "./plugins/withAdhanAlarm.js",
      "./plugins/withHaramainCleartext.js",
      "expo-sharing",
      "expo-video"
    ]
  }
}
