{
  "expo": {
    "name": "Islamic",
    "slug": "islamic-companion",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2D187D",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qashi.islamic",
      "icon": {
        "light": "./assets/ios-icon-light.png",
        "dark": "./assets/ios-icon-dark.png"
      }
    },
    "android": {
      "package": "com.qashi.islamic",
      "adaptiveIcon": {
        "backgroundColor": "#2D187D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_mishary_rashid_alafasy.m4a",
            "./assets/sounds/adhan_mansour_al_zahrani.m4a",
            "./assets/sounds/adhan_hafiz_mustafa_ozcan.m4a",
            "./assets/sounds/adhan_ahmad_al_nafees.m4a",
            "./assets/sounds/adhan_abdul_basit.m4a",
            "./assets/sounds/adhan_minshawi.m4a",
            "./assets/sounds/fajr_mansour_al_zahrani.m4a",
            "./assets/sounds/fajr_traditional.m4a"
          ]
        }
      ],
      "./plugins/withBatteryExemption.js",
      "./plugins/withAdhanAlarm.js",
      "./plugins/withHaramainCleartext.js",
      "expo-sharing",
      "expo-video"
    ]
  }
}
